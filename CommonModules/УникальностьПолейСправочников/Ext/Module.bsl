Функция ПолеУникально(Справочник, Поле, Значение, Ссылка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 %1.Ссылка
	|ИЗ Справочник.%1 КАК %1
	|ГДЕ 
	|	%1.%2 = &%2
	|И
	|	%1.Ссылка <> &Ссылка", Справочник, Поле);
	Запрос.УстановитьПараметр(Поле, Значение);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Запрос.Выполнить().Пустой();
КонецФункции