
Процедура ПередЗаписьюВыполненияРаботПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 ВыполнениеРабот.ТипРаботы
	|ИЗ Документ.ВыполнениеРабот КАК ВыполнениеРабот
	|ГДЕ ВыполнениеРабот.Заявка = &Заявка
	|УПОРЯДОЧИТЬ ПО ВыполнениеРабот.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Заявка", Источник.Заявка.Ссылка);
	
	ПоследнийТипРаботы = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПоследнийТипРаботы = Выборка.ТипРаботы;
	КонецЕсли;
	
	Если ПоследнийТипРаботы = Неопределено 
		ИЛИ ПоследнийТипРаботы <> Источник.ТипРаботы Тогда
		Если Источник.ТипРаботы = Перечисления.ТипыРабот.Диагностика Тогда
			ЗаписатьВРегистр(Перечисления.СтатусыЗаявок.ВДиагностике, Источник.Заявка.Ссылка);
		ИначеЕсли Источник.ТипРаботы = Перечисления.ТипыРабот.Ремонт Тогда
			ЗаписатьВРегистр(Перечисления.СтатусыЗаявок.ВРемонте, Источник.Заявка.Ссылка);
		ИначеЕсли Источник.ТипРаботы = Перечисления.ТипыРабот.Завершение Тогда
			ЗаписатьВРегистр(Перечисления.СтатусыЗаявок.Готова, Источник.Заявка.Ссылка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ЗаписатьВРегистр(Статус, Ссылка)
	МенеджерЗаписи = РегистрыСведений.СтатусыЗаявок.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Заявка = Ссылка;
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.Прочитать();
	
	МенеджерЗаписи.Статус = Статус;
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.Заявка = Ссылка;
	МенеджерЗаписи.Записать();
КонецФункции

Процедура ПроведениеВыполнениеРаботОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	ПоследниеЦеныУслуг = ПолучитьПоследниеЦеныУслуг();
	ПроверкаЦенУслуг(Источник.СписокУслуг, Отказ, ПоследниеЦеныУслуг);
	
	ПоследниеЦеныЗапчастей = ПолучитьПоследниеЦеныЗапчастей();
	ПроверкаЦенЗапчастей(Источник.СписокЗапчастей, Отказ, ПоследниеЦеныЗапчастей);
	
	КоличествоЗапчастей = ПолучитьКоличествоЗапчастей();
	ПроверкаКоличестваЗапчастей(Источник.СписокЗапчастей, Отказ, КоличествоЗапчастей);
КонецПроцедуры 

Функция ПолучитьПоследниеЦеныУслуг()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ЦеныУслуг.Услуга.Ссылка КАК Услуга
	|ИЗ РегистрСведений.ЦеныУслуг.СрезПоследних(&Дата) КАК ЦеныУслуг";
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПоследниеЦены = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		ПоследниеЦены.Вставить(Выборка.Услуга, Выборка.Услуга);
	КонецЦикла;
	
	Возврат ПоследниеЦены;
КонецФункции 

Процедура ПроверкаЦенУслуг(СписокУслуг, Отказ, ПоследниеЦеныУслуг)
	Для Каждого Запись Из СписокУслуг Цикл
		Если ПоследниеЦеныУслуг.Получить(Запись.Услуга.Ссылка) = Неопределено
			ИЛИ НЕ ЗначениеЗаполнено(Запись.Цена) Тогда
			Сообщить("Ошибка проведения. Убедитесь, что для всех услуг есть запись в регистре сведений. " + 
			"Если вы уверены, что запись есть, попробуйте заново выбрать услугу.");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

