КонецПроцедуры

Функция ПолучитьКоличествоЗапчастей()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ОстаткиЗапчастей.КоличествоОстаток КАК Количество,
	|	ОстаткиЗапчастей.Запчасть.Ссылка КАК Запчасть
	|ИЗ РегистрНакопления.ОстаткиЗапчастей.Остатки(&Дата) КАК ОстаткиЗапчастей";
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		Количество.Вставить(Выборка.Запчасть, Выборка.Количество);
	КонецЦикла;
	
	Возврат Количество;
КонецФункции

Процедура ПроверкаКоличестваЗапчастей(СписокЗапчастей, Отказ, КоличествоЗапчастей)
	Для Каждого Запись Из СписокЗапчастей Цикл
		КоличествоЗапчасти = КоличествоЗапчастей.Получить(Запись.Запчасть.Ссылка);
		Если КоличествоЗапчасти = Неопределено
			ИЛИ НЕ ЗначениеЗаполнено(Запись.Цена)
			ИЛИ КоличествоЗапчасти < Запись.Количество Тогда
			Сообщить("Ошибка проведения. Убедитесь, запчастей на складе достаточно. " + 
			"Если вы уверены, что запчастей достаточно, попробуйте заново выбрать запчасть.");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
